# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# WebSocket Configuration
WS_URL=wss://ws2.market-qx.trade/socket.io/?EIO=3&transport=websocket

# Strategy Configuration
SIGNAL_COOLDOWN_MS=300000
DUPLICATE_PROTECTION_MS=600000
SENSITIVITY=medium

# Server Configuration
PORT=3000
NODE_ENV=production

# Simulation Mode (set to 'true' to run in simulation mode)
SIMULATE_MARKET=false

# Auto Trading (disabled by default due to ESM dependency issues)
# Only enable if you have Quotex credentials and want automatic trading
AUTO_TRADE_ENABLED=false
QUOTEX_EMAIL=
QUOTEX_PASSWORD=
TRADE_AMOUNT=10
TRADE_DEMO=true
